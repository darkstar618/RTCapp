const rateLimit = require('express-rate-limit');

// Per-app-id rate limiting using in-memory store (swap for Redis in Week 11-12)
const limiter = rateLimit({
  windowMs: 60 * 1000,      // 1 minute window
  max: 120,                  // 120 requests/min per app_id
  keyGenerator: (req) => req.sdk?.app_id || req.ip,
  standardHeaders: true,
  legacyHeaders: false,
  handler: (req, res) => res.status(429).json({ error: 'Rate limit exceeded' }),
});

module.exports = limiter;